{{!
    @template theme_lovely/marketingspots

    Front page marketing spots (original theme_lovely template): a row of up to four
    highlight cards under the hero slider.

    Context variables required for this template:
    * spots - array of {icon, heading, text, url}
    * columnclass - Bootstrap column classes sizing the row

    Example context (json):
    {
        "columnclass": "col-sm-6 col-lg-3",
        "spots": [
            {
                "icon": "fa-graduation-cap",
                "heading": "Learn anywhere",
                "text": "Courses that work on any device.",
                "url": "https://example.com/courses"
            }
        ]
    }
}}
<section class="lovely-marketing d-print-none container-fluid" aria-label="{{#str}} marketingheading, theme_lovely {{/str}}">
    <div class="row g-4 justify-content-center">
        {{#spots}}
            <div class="{{columnclass}}">
                <div class="lovely-marketing-spot card h-100 text-center{{#url}} lovely-marketing-linked{{/url}}">
                    <div class="card-body">
                        {{#icon}}
                            <span class="lovely-marketing-icon" aria-hidden="true">
                                <i class="fa {{icon}} fa-fw"></i>
                            </span>
                        {{/icon}}
                        <h3 class="lovely-marketing-heading h5">
                            {{#url}}<a href="{{url}}" class="stretched-link">{{heading}}</a>{{/url}}
                            {{^url}}{{heading}}{{/url}}
                        </h3>
                        {{#text}}<p class="lovely-marketing-text mb-0">{{text}}</p>{{/text}}
                    </div>
                </div>
            </div>
        {{/spots}}
    </div>
</section>
