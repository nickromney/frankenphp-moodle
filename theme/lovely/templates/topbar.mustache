{{!
    @template theme_lovely/topbar

    Slim contact/social strip rendered above the main navigation row, inside the fixed
    navbar container (original theme_lovely template).

    Context variables required for this template:
    * phone - contact phone number or null
    * phonehref - tel: link target or null
    * email - contact email or null
    * showlogin - whether to show a login link (guests only)
    * loginurl - the login page URL
    * socialicons - array of {name, url, icon, label}

    Example context (json):
    {
        "phone": "+44 20 946 0000",
        "phonehref": "tel:+44209460000",
        "email": "hello@example.com",
        "showlogin": true,
        "loginurl": "https://example.com/login/index.php",
        "socialicons": [
            { "name": "facebook", "url": "https://facebook.com/example", "icon": "fa-brands fa-facebook-f", "label": "Facebook" }
        ]
    }
}}
<div class="lovely-topbar w-100 d-none d-md-flex align-items-center">
    <div class="lovely-topbar-contact d-flex align-items-center">
        {{#phone}}
            <a class="lovely-topbar-item" href="{{phonehref}}">
                <i class="fa fa-phone fa-fw" aria-hidden="true"></i>{{phone}}
            </a>
        {{/phone}}
        {{#email}}
            <a class="lovely-topbar-item" href="mailto:{{email}}">
                <i class="fa fa-envelope fa-fw" aria-hidden="true"></i>{{email}}
            </a>
        {{/email}}
    </div>
    <div class="lovely-topbar-actions ms-auto d-flex align-items-center">
        {{#socialicons}}
            <a class="lovely-topbar-social" href="{{url}}" title="{{label}}">
                <i class="fa {{icon}} fa-fw" aria-hidden="true"></i>
                <span class="visually-hidden">{{label}}</span>
            </a>
        {{/socialicons}}
        {{#showlogin}}
            <a class="lovely-topbar-item lovely-topbar-login" href="{{loginurl}}">
                <i class="fa fa-right-to-bracket fa-fw" aria-hidden="true"></i>{{#str}} login, core {{/str}}
            </a>
        {{/showlogin}}
    </div>
</div>
