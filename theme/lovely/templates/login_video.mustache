{{!
    @template theme_lovely/login_video

    Full-page login background video (original theme_lovely template). No autoplay attribute:
    theme_lovely/motion plays the video only when the visitor does not prefer reduced motion;
    the poster (the configured login background image, when set) is the static fallback.

    Context variables required for this template:
    * videourl - the uploaded video URL
    * posterurl - poster image URL or null

    Example context (json):
    {
        "videourl": "https://example.com/pluginfile.php/1/theme_lovely/loginbackgroundvideo/0/campus.mp4",
        "posterurl": null
    }
}}
<div class="lovely-login-video-wrap" aria-hidden="true">
    <video class="lovely-login-video" muted loop playsinline preload="metadata"
           {{#posterurl}}poster="{{posterurl}}"{{/posterurl}}
           data-lovely-autoplay="1" tabindex="-1">
        <source src="{{videourl}}">
    </video>
</div>
{{#js}}
require(['theme_lovely/motion'], function(Motion) {
    Motion.init();
});
{{/js}}
